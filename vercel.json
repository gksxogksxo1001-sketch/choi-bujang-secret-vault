{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/restore/notes/:id", "destination": "/api/notes?id=:id&action=restore" },
    { "source": "/api/notes/restore/:id", "destination": "/api/notes?id=:id&action=restore" },
    { "source": "/api/notes/restore", "destination": "/api/notes?action=restore" },
    { "source": "/api/notes/audit", "destination": "/api/notes?action=audit" },
    { "source": "/api/operations", "destination": "/api/notes" },
    { "source": "/api/notes/:id", "destination": "/api/notes?id=:id" }
  ]
}
